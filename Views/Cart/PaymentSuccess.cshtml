@{
    ViewData["Title"] = "Payment Success";
}

<div class="container mt-5 text-center py-5">
    <div class="bg-white p-5 rounded-4 shadow-sm d-inline-block" style="max-width: 500px;">
        <i class="fas fa-check-circle fa-5x text-success mb-4 animate__animated animate__bounceIn"></i>
        <h2 class="fw-bold mb-3">Order Placed Successfully!</h2>
        <p class="text-muted mb-4">@ViewBag.Message</p>
        <p class="text-muted mb-4">Thank you for your purchase. Your order has been placed and is currently being processed.</p>
        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-bold">Continue Shopping</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill">Back to Home</a>
        </div>
    </div>
</div>
