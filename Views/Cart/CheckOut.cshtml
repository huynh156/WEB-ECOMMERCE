@model FashionHubWeb.ViewModels.CheckOutVM
@{
    ViewData["Title"] = "Checkout";
    var cartItems = ViewBag.CartItems as IEnumerable<FashionHubWeb.Models.Cart> ?? new List<FashionHubWeb.Models.Cart>();
    decimal subTotal = cartItems.Sum(p => (p.Product?.Price ?? 0m) * p.Quantity);
    decimal tax = subTotal * 0.1m;
    decimal grandTotal = subTotal + tax;
}

<div class="container mt-5 mb-5">
    <div class="row">
        <!-- Billing Details Column -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm border-0 p-4">
                <h3 class="fw-bold mb-4">Billing details</h3>
                
                <form id="checkoutForm" method="post" asp-action="CheckOut" asp-controller="Cart" class="needs-validation">
                    <input type="hidden" id="couponCodeInput" name="CouponCode" value="" />
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Full Name</label>
                        <input asp-for="FullName" id="username" class="form-control" placeholder="Enter your full name" required>
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">Delivery Address</label>
                        <input asp-for="Address" id="address" class="form-control" placeholder="Street address, City, Country" required>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                        <input asp-for="PhoneNumber" id="PhoneNumber" type="tel" class="form-control" placeholder="0123456789" required>
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">Order Notes (Optional)</label>
                        <textarea asp-for="Notes" id="notes" class="form-control" rows="3" placeholder="Notes about your order, e.g. special notes for delivery."></textarea>
                    </div>

                    <hr class="my-4">

                    <h4 class="fw-bold mb-3">Payment Method</h4>
                    
                    <div class="d-grid gap-2 mb-4">
                        <input type="submit" name="payment" value="Thanh Toán Bằng COD" class="btn btn-outline-dark py-3 fw-bold rounded-pill">
                        <input type="submit" name="payment" value="Thanh Toán Bằng VN PAY" class="btn btn-primary py-3 fw-bold rounded-pill">
                    </div>

                    <div id="paypal-button-container" class="mt-3"></div>
                </form>
            </div>
        </div>

        <!-- Order Summary Column -->
        <div class="col-md-5 mb-4">
            <div class="card shadow-sm border-0 p-4 bg-light">
                <h3 class="fw-bold mb-4">Your order</h3>
                
                <div class="table-responsive mb-4">
                    <table class="table align-middle table-borderless">
                        <thead>
                            <tr class="border-bottom text-muted small">
                                <th scope="col">Product</th>
                                <th scope="col" class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in cartItems)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">@item.Product?.ProductName</span>
                                        <div class="text-muted small">Qty: @item.Quantity &times; $@item.Product?.Price</div>
                                    </td>
                                    <td class="text-end fw-semibold">$@((item.Product?.Price * item.Quantity)?.ToString("0.00"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <hr class="my-3">

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Subtotal</span>
                    <span class="fw-semibold">$@subTotal.ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">VAT (10%)</span>
                    <span class="fw-semibold">$@tax.ToString("0.00")</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Shipping</span>
                    <span class="text-success fw-semibold">Free</span>
                </div>

                <div class="d-flex justify-content-between mb-2 text-danger" id="discountRow" style="display: none !important;">
                    <span>Discount</span>
                    <span id="discountValue">-$0.00</span>
                </div>

                <!-- Coupon Input -->
                <div class="mb-3 pt-3 border-top">
                    <label class="form-label small text-muted fw-bold">PROMO CODE</label>
                    <div class="input-group">
                        <input type="text" id="couponCodeRaw" class="form-control" placeholder="Enter coupon code...">
                        <button type="button" class="btn btn-outline-dark" id="btnApplyCoupon">Apply</button>
                    </div>
                    <div id="couponMessage" class="small mt-2" style="display:none;"></div>
                </div>

                <hr class="my-3">

                <div class="d-flex justify-content-between mb-4">
                    <span class="fw-bold fs-5">Total</span>
                    <span class="fw-bold fs-5 text-primary" id="grandTotalValue">$@grandTotal.ToString("0.00")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.PaypalClientId"></script>
    
    <script>
        var originalGrandTotal = @grandTotal;
        var subTotal = @subTotal;

        $('#btnApplyCoupon').click(function() {
            var code = $('#couponCodeRaw').val().trim();
            if (!code) {
                $('#couponMessage').text('Please enter a coupon code.').removeClass('text-success').addClass('text-danger').show();
                return;
            }
            
            $.ajax({
                url: '/Cart/ApplyCoupon',
                type: 'POST',
                data: {
                    couponCode: code,
                    orderTotal: subTotal
                },
                success: function(response) {
                    if (response.success) {
                        $('#couponMessage').text('Coupon applied successfully!').removeClass('text-danger').addClass('text-success').show();
                        $('#couponCodeInput').val(code);
                        
                        var discount = parseFloat(response.discount);
                        var newGrandTotal = Math.max(0, originalGrandTotal - discount);
                        
                        $('#discountValue').text(response.discountText);
                        $('#discountRow').css('display', 'flex').attr('style', 'display: flex !important;');
                        $('#grandTotalValue').text('$' + newGrandTotal.toFixed(2));
                    } else {
                        $('#couponMessage').text(response.message).removeClass('text-success').addClass('text-danger').show();
                        $('#couponCodeInput').val('');
                        $('#discountRow').css('display', 'none').attr('style', 'display: none !important;');
                        $('#grandTotalValue').text('$' + originalGrandTotal.toFixed(2));
                    }
                },
                error: function() {
                    $('#couponMessage').text('Error checking coupon.').removeClass('text-success').addClass('text-danger').show();
                }
            });
        });

        paypal.Buttons({
            style: {
                layout: 'vertical',
                color: 'blue',
                shape: 'pill',
                label: 'paypal'
            },
            createOrder: (data, actions) => {
                var form = document.getElementById('checkoutForm');
                if (!form.checkValidity()) {
                    form.reportValidity();
                    return Promise.reject(new Error("Form is invalid."));
                }

                var appliedCoupon = $('#couponCodeInput').val();
                var url = '/Cart/PaypalOrder' + (appliedCoupon ? '?couponCode=' + encodeURIComponent(appliedCoupon) : '');

                return fetch(url, {
                    method: "post"
                }).then((response) => {
                    if (!response.ok) {
                        return response.json().then(error => { throw error; });
                    }
                    return response.json();
                }).then((order) => order.id)
                  .catch(error => alert(error.message));
            },
            onApprove: (data, actions) => {
                var model = {
                    FullName: $('#username').val(),
                    Address: $('#address').val(),
                    PhoneNumber: parseInt($('#PhoneNumber').val()) || null,
                    Notes: $('#notes').val(),
                    CouponCode: $('#couponCodeInput').val(),
                    SameAddress: false
                };

                return fetch(`/Cart/CapturePaypalOrder?orderId=${data.orderID}`, {
                    method: "post",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(model)
                }).then((response) => {
                    if (!response.ok) {
                        return response.json().then(error => { throw error; });
                    }
                    window.location.href = "/Cart/PaymentSuccess";
                }).catch(error => alert(error.message));
            }
        }).render('#paypal-button-container');
    </script>
}
