@model FashionHubWeb.ViewModels.ProfileVM
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5 mt-5">
    <div class="row">
        <!-- Sidebar -->
        <div class="col-lg-3 mb-4 mb-lg-0">
            <div class="card border-0 shadow-sm p-3 rounded-3" style="background-color: #FAF6F0;">
                <div class="nav flex-column nav-pills">
                    <a class="nav-link active py-3 px-4 rounded-pill fw-bold" asp-controller="Account" asp-action="Profile">
                        <i class="fas fa-user me-3"></i>My Profile
                    </a>
                    <a class="nav-link py-3 px-4 rounded-pill fw-bold text-muted" asp-controller="Account" asp-action="Orders">
                        <i class="fas fa-shopping-bag me-3"></i>Order History
                    </a>
                    <a class="nav-link py-3 px-4 rounded-pill fw-bold text-muted" asp-controller="Cart" asp-action="Index">
                        <i class="fas fa-shopping-cart me-3"></i>My Cart
                    </a>
                    <a class="nav-link py-3 px-4 rounded-pill fw-bold text-muted" asp-controller="Account" asp-action="Logout">
                        <i class="fas fa-sign-out-alt me-3"></i>Logout
                    </a>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm p-4 rounded-3 bg-white">
                <h3 class="fw-bold mb-4">My Profile</h3>

                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle me-2"></i>@TempData["ProfileSuccess"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="mb-4 pb-4 border-bottom">
                    <div class="row align-items-center">
                        <div class="col-md-2 text-center text-md-start mb-3 mb-md-0">
                            <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                                <i class="fas fa-user text-secondary fa-2x"></i>
                            </div>
                        </div>
                        <div class="col-md-10 text-center text-md-start">
                            <h5 class="fw-bold mb-1">@Model.Username</h5>
                            <span class="badge bg-dark rounded-pill px-3">@Model.Role</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Profile" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="Username" />
                    <input type="hidden" asp-for="Role" />

                    <div class="row mb-4">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FullName" class="form-label fw-bold">Full Name</label>
                            <input asp-for="FullName" class="form-control form-control-lg rounded-3" placeholder="Enter your full name" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-bold">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control form-control-lg rounded-3" placeholder="Enter your email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-bold">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control form-control-lg rounded-3" placeholder="Enter your phone number" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Address" class="form-label fw-bold">Address</label>
                            <input asp-for="Address" class="form-control form-control-lg rounded-3" placeholder="Enter your address" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Change Password Accordion -->
                    <div class="accordion mb-4" id="passwordAccordion">
                        <div class="accordion-item border-0 bg-light rounded-3">
                            <h2 class="accordion-header" id="headingPassword">
                                <button class="accordion-button collapsed bg-light rounded-3 fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#collapsePassword" aria-expanded="false" aria-controls="collapsePassword">
                                    <i class="fas fa-lock me-2"></i> Change Password
                                </button>
                            </h2>
                            <div id="collapsePassword" class="accordion-collapse collapse" aria-labelledby="headingPassword" data-bs-parent="#passwordAccordion">
                                <div class="accordion-body pb-2 pt-4">
                                    <div class="mb-3">
                                        <label asp-for="CurrentPassword" class="form-label fw-bold">Current Password</label>
                                        <input asp-for="CurrentPassword" type="password" class="form-control rounded-3" placeholder="Enter current password" />
                                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="NewPassword" class="form-label fw-bold">New Password</label>
                                        <input asp-for="NewPassword" type="password" class="form-control rounded-3" placeholder="Enter new password" />
                                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="ConfirmNewPassword" class="form-label fw-bold">Confirm New Password</label>
                                        <input asp-for="ConfirmNewPassword" type="password" class="form-control rounded-3" placeholder="Confirm new password" />
                                        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-end">
                        <button type="submit" class="btn btn-dark btn-lg px-5 rounded-pill fw-bold">
                            Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
