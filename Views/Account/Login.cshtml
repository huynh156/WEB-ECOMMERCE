@model FashionHubWeb.Models.LoginVM
@{
    ViewData["Title"] = "Login";
}

<div class="container py-5 my-5 d-flex justify-content-center">
    <div class="card border-0 shadow-sm p-4 p-md-5 bg-white rounded-4" style="max-width: 480px; width: 100%;">
        <div class="text-center mb-4">
            <h2 class="fw-bold tracking-wider text-uppercase text-dark" style="font-size: 1.6rem; letter-spacing: 2px;">Sign In</h2>
            <p class="text-muted small">Enter your credentials to access your account</p>
        </div>

        <form asp-action="Login" method="post" class="needs-validation">
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 px-3 border-0 rounded-3 mb-4"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label small fw-bold text-muted text-uppercase" style="letter-spacing: 1px;">Username or Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0" style="border-radius: 8px 0 0 8px;"><i class="fas fa-envelope text-muted"></i></span>
                    <input asp-for="Username" class="form-control bg-light border-start-0 py-2" placeholder="username or email" style="border-radius: 0 8px 8px 0;" required />
                </div>
                <span asp-validation-for="Username" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between">
                    <label asp-for="Password" class="form-label small fw-bold text-muted text-uppercase" style="letter-spacing: 1px;">Password</label>
                </div>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0" style="border-radius: 8px 0 0 8px;"><i class="fas fa-lock text-muted"></i></span>
                    <input asp-for="Password" type="password" class="form-control bg-light border-start-0 py-2" placeholder="••••••••" style="border-radius: 0 8px 8px 0;" required />
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="d-grid gap-2 mb-4">
                <button type="submit" class="btn btn-dark py-2.5 rounded-pill fw-bold text-uppercase" style="letter-spacing: 1.5px; font-size: 0.9rem;">Sign In</button>
            </div>
        </form>

        <div class="text-center position-relative my-4">
            <hr class="text-muted">
            <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small fw-semibold">OR</span>
        </div>

        <div class="d-grid gap-2 mb-4">
            <a asp-action="GoogleLogin" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-outline-dark py-2.5 rounded-pill fw-bold text-uppercase d-flex align-items-center justify-content-center gap-2" style="letter-spacing: 1px; font-size: 0.85rem;">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-google" viewBox="0 0 16 16">
                    <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0c2.204 0 4.09.799 5.56 2.25h-2.9A4.57 4.57 0 1 0 8 11.5c2.4 0 4.1-1.68 4.1-4.12 0-.327-.033-.654-.09-.97h-4v2.535h6.97z"/>
                </svg>
                Continue with Google
            </a>
        </div>

        <div class="text-center">
            <p class="text-muted small mb-0">Don't have an account? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-dark fw-bold text-decoration-none hover-primary">Create an account</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
