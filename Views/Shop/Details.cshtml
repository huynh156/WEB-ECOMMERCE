@model FashionHubWeb.Models.Product
@{
    ViewData["Title"] = Model.ProductName;
    ViewData["CategoryName"] = Model.Category?.CategoryName;
    ViewData["CategoryId"] = Model.CategoryId;
}

<div class="container mt-5">
    <div class="row bg-white p-5 rounded-4 shadow-sm">
        <div class="col-md-6 mb-4 text-center d-flex align-items-center justify-content-center bg-light rounded" style="min-height: 400px;">
            @if (string.IsNullOrEmpty(Model.Image))
            {
                <i class="fas fa-image fa-6x text-muted opacity-25"></i>
            }
            else
            {
                <img src="@Model.Image" class="img-fluid rounded shadow-sm" alt="@Model.ProductName" style="width: 100%; height: 100%; object-fit: cover; max-height: 500px;" onerror="this.src='https://via.placeholder.com/500x500?text=No+Image';this.onerror='';">
            }
        </div>
        <div class="col-md-6 px-md-5 d-flex flex-column justify-content-center">

            <h1 class="fw-bold mb-2">@Model.ProductName</h1>
            <p class="text-muted mb-4"><i class="fas fa-tag"></i> Brand: <span class="fw-semibold text-dark">@Model.Brand?.BrandName</span></p>
            
            <h2 class="product-price fs-1 mb-4">$@Model.Price</h2>
            
            <div class="mb-4">
                <p class="mb-1"><strong>Availability:</strong> 
                    @if (Model.StockQuantity > 0)
                    {
                        <span class="text-success"><i class="fas fa-check-circle"></i> In Stock (@Model.StockQuantity)</span>
                    }
                    else
                    {
                        <span class="text-danger"><i class="fas fa-times-circle"></i> Out of Stock</span>
                    }
                </p>
            </div>

            <p class="mb-4 lh-lg text-muted">@Model.Description</p>

            <div class="d-grid gap-3 d-md-flex justify-content-md-start mb-4">
                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex align-items-center gap-3">
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <div class="input-group" style="width: 130px;">
                        <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('qty').value = Math.max(1, parseInt(document.getElementById('qty').value) - 1)">-</button>
                        <input type="number" id="qty" name="quantity" class="form-control text-center" value="1" min="1" max="@Model.StockQuantity">
                        <button class="btn btn-outline-secondary" type="button" onclick="document.getElementById('qty').value = Math.min(@Model.StockQuantity, parseInt(document.getElementById('qty').value) + 1)">+</button>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg px-4" @(Model.StockQuantity == 0 ? "disabled" : "")>
                        <i class="fas fa-shopping-cart me-2"></i>Add to Cart
                    </button>
                </form>
                
                <button class="btn btn-outline-danger btn-lg px-4 btn-wishlist" data-product-id="@Model.ProductId">
                    <i class="@(ViewBag.WishlistProductIds != null && ((List<string>)ViewBag.WishlistProductIds).Contains(Model.ProductId) ? "fas fa-heart" : "far fa-heart")"></i>
                </button>
            </div>
            
            <!-- Accordion Details (Luxury Style) -->
            <div class="accordion accordion-flush mt-5 border-top" id="productDetailsAccordion">
                <div class="accordion-item bg-transparent">
                    <h2 class="accordion-header" id="headingOne">
                        <button class="accordion-button collapsed bg-transparent px-0 py-3 fw-bold text-dark border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                            PRODUCT DESCRIPTION
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#productDetailsAccordion">
                        <div class="accordion-body px-0 text-muted lh-lg">
                            @Model.Description
                        </div>
                    </div>
                </div>
                <div class="accordion-item bg-transparent">
                    <h2 class="accordion-header" id="headingTwo">
                        <button class="accordion-button collapsed bg-transparent px-0 py-3 fw-bold text-dark border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                            MATERIALS & CARE
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#productDetailsAccordion">
                        <div class="accordion-body px-0 text-muted lh-lg">
                            <ul>
                                <li>100% premium quality construction.</li>
                                <li>Made in Italy / France.</li>
                                <li>Dry clean only. Handle with extreme care.</li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="accordion-item bg-transparent">
                    <h2 class="accordion-header" id="headingThree">
                        <button class="accordion-button collapsed bg-transparent px-0 py-3 fw-bold text-dark border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                            SHIPPING & RETURNS
                        </button>
                    </h2>
                    <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#productDetailsAccordion">
                        <div class="accordion-body px-0 text-muted lh-lg">
                            We offer complimentary shipping and returns on all orders. Deliveries are made within 3-5 business days. Items returned must be in their original packaging with tags intact.
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </div>

    <!-- Related Products -->
    @if (ViewBag.RelatedProducts != null && ((IEnumerable<FashionHubWeb.Models.Product>)ViewBag.RelatedProducts).Any())
    {
        <div class="mt-5 pt-5 border-top mb-5">
            <h3 class="fw-bold mb-4 text-center">You May Also Like</h3>
            <div class="row">
                @foreach (var item in (IEnumerable<FashionHubWeb.Models.Product>)ViewBag.RelatedProducts)
                {
                    var isWishlisted = ViewBag.WishlistProductIds != null && ((List<string>)ViewBag.WishlistProductIds).Contains(item.ProductId);
                    <div class="col-md-3 col-sm-6 mb-4">
                        <div class="card h-100 shadow-sm border-0 product-card overflow-hidden position-relative bg-white rounded-3">
                            <img src="@item.Image" class="card-img-top object-fit-cover" alt="@item.ProductName" style="height: 250px; transition: transform 0.5s ease;" onerror="this.src='https://via.placeholder.com/250?text=No+Image';this.onerror=null;">
                            <div class="position-absolute top-0 end-0 p-3" style="z-index: 10;">
                                <button class="btn btn-light shadow-sm btn-wishlist rounded-circle" data-product-id="@item.ProductId" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; border: none;">
                                    <i class="@(isWishlisted ? "fas fa-heart text-danger" : "far fa-heart text-dark")"></i>
                                </button>
                            </div>
                            <div class="card-body text-center d-flex flex-column justify-content-between p-3">
                                <div>
                                    <p class="text-muted text-uppercase tracking-wider fw-bold mb-1" style="font-size: 0.75rem;">@item.Brand?.BrandName</p>
                                    <h5 class="card-title text-truncate fw-bold fs-6 mb-2" title="@item.ProductName">@item.ProductName</h5>
                                    <p class="product-price fw-bold text-primary mb-3">$@item.Price.ToString("0.00")</p>
                                </div>
                                <div class="d-grid gap-2">
                                    <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-dark rounded-pill fw-bold small py-2">View Details</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).on('click', '.btn-wishlist', function(e) {
            e.preventDefault();
            var btn = $(this);
            var prodId = btn.data('product-id');
            
            $.ajax({
                url: '/Wishlist/Toggle',
                type: 'POST',
                data: { productId: prodId },
                headers: { "X-Requested-With": "XMLHttpRequest" },
                success: function(response) {
                    if (response.success) {
                        var icon = btn.find('i');
                        if (response.added) {
                            icon.removeClass('far text-dark').addClass('fas fa-heart text-danger');
                        } else {
                            icon.removeClass('fas text-danger').addClass('far fa-heart text-dark');
                        }
                    } else {
                        window.location.href = '/Account/Login';
                    }
                },
                error: function() {
                    window.location.href = '/Account/Login';
                }
            });
        });
    </script>
}
