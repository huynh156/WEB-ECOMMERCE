@model IEnumerable<FashionHubWeb.Models.Product>
@{
    ViewData["Title"] = "Shop";
}

<div class="container mt-4">
    <div class="row">
        <!-- Sidebar Filters -->
        <div class="col-md-3 mb-4">
            <div class="card p-3 shadow-sm mb-4">
                <h5 class="fw-bold mb-3">Categories</h5>
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <a href="#" class="text-decoration-none category-filter @(string.IsNullOrEmpty(ViewBag.CurrentCategory) ? "fw-bold text-dark" : "text-muted")" data-category="">All Categories</a>
                    </li>
                    @foreach (var cat in ViewBag.Categories)
                    {
                        <li class="mb-2">
                            <a href="#" class="text-decoration-none category-filter @(ViewBag.CurrentCategory == cat.CategoryId ? "fw-bold text-dark" : "text-muted")" data-category="@cat.CategoryId">@cat.CategoryName</a>
                        </li>
                    }
                </ul>
            </div>
            
            <div class="card p-3 shadow-sm mb-4">
                <h5 class="fw-bold mb-3">Brands</h5>
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <a href="#" class="text-decoration-none brand-filter @(string.IsNullOrEmpty(ViewBag.CurrentBrand) ? "fw-bold text-dark" : "text-muted")" data-brand="">All Brands</a>
                    </li>
                    @foreach (var brand in ViewBag.Brands)
                    {
                        <li class="mb-2">
                            <a href="#" class="text-decoration-none brand-filter @(ViewBag.CurrentBrand == brand.BrandId ? "fw-bold text-dark" : "text-muted")" data-brand="@brand.BrandId">@brand.BrandName</a>
                        </li>
                    }
                </ul>
            </div>

            <div class="card p-3 shadow-sm mb-4">
                <h5 class="fw-bold mb-3">Price Range</h5>
                <div class="d-flex align-items-center mb-2">
                    <input type="number" id="minPrice" class="form-control form-control-sm me-2 price-filter" placeholder="Min" value="@ViewBag.CurrentMinPrice" min="@ViewBag.PriceRangeMin" max="@ViewBag.PriceRangeMax" />
                    <span>-</span>
                    <input type="number" id="maxPrice" class="form-control form-control-sm ms-2 price-filter" placeholder="Max" value="@ViewBag.CurrentMaxPrice" min="@ViewBag.PriceRangeMin" max="@ViewBag.PriceRangeMax" />
                </div>
            </div>

            <button type="button" class="btn btn-outline-danger w-100 fw-bold shadow-sm" onclick="clearAllFilters()">Clear All Filters</button>
        </div>

        <!-- Product Grid -->
        <div class="col-md-9">
            <div class="d-flex justify-content-end align-items-center mb-3">
                <div class="d-flex align-items-center">
                    <label for="sortSelect" class="me-2 fw-bold text-muted mb-0">Sort By:</label>
                    <select id="sortSelect" class="form-select form-select-sm w-auto shadow-sm">
                        <option value="" selected="@(string.IsNullOrEmpty(ViewBag.CurrentSort) ? "selected" : null)">Default (Newest)</option>
                        <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc" ? "selected" : null)">Price: Low to High</option>
                        <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc" ? "selected" : null)">Price: High to Low</option>
                        <option value="name_asc" selected="@(ViewBag.CurrentSort == "name_asc" ? "selected" : null)">Name: A to Z</option>
                        <option value="name_desc" selected="@(ViewBag.CurrentSort == "name_desc" ? "selected" : null)">Name: Z to A</option>
                    </select>
                </div>
            </div>
            
            <div id="loadingSpinner" class="text-center py-5" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <div id="productGrid">
                <partial name="_ProductGrid" model="Model" />
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="currentQuery" value="@ViewBag.SearchQuery" />
<input type="hidden" id="currentCategory" value="@ViewBag.CurrentCategory" />
<input type="hidden" id="currentBrand" value="@ViewBag.CurrentBrand" />

@section Scripts {
    <script>
        // Existing wishlist logic
        $(document).on('click', '.btn-wishlist', function(e) {
            e.preventDefault();
            var btn = $(this);
            var prodId = btn.data('product-id');
            
            $.ajax({
                url: '/Wishlist/Toggle',
                type: 'POST',
                data: { productId: prodId },
                headers: { "X-Requested-With": "XMLHttpRequest" },
                success: function(response) {
                    if (response.success) {
                        var icon = btn.find('i');
                        if (response.added) {
                            icon.removeClass('far text-dark').addClass('fas fa-heart text-danger');
                        } else {
                            icon.removeClass('fas text-danger').addClass('far fa-heart text-dark');
                        }
                    } else {
                        window.location.href = '/Account/Login';
                    }
                },
                error: function() {
                    window.location.href = '/Account/Login';
                }
            });
        });

        // AJAX Filtering Logic
        let filterTimeout;

        function loadProducts() {
            var query = $('#currentQuery').val();
            var category = $('#currentCategory').val();
            var brand = $('#currentBrand').val();
            var sort = $('#sortSelect').val();
            var minPrice = $('#minPrice').val();
            var maxPrice = $('#maxPrice').val();

            var data = {};
            if (query) data.query = query;
            if (category) data.category = category;
            if (brand) data.brand = brand;
            if (sort) data.sort = sort;
            if (minPrice) data.minPrice = minPrice;
            if (maxPrice) data.maxPrice = maxPrice;

            $('#productGrid').hide();
            $('#loadingSpinner').show();

            $.ajax({
                url: '@Url.Action("Index", "Shop")',
                type: 'GET',
                data: data,
                headers: { "X-Requested-With": "XMLHttpRequest" },
                success: function (result) {
                    $('#productGrid').html(result);
                    $('#loadingSpinner').hide();
                    $('#productGrid').show();

                    // Update URL
                    var url = new URL(window.location.href);
                    url.search = new URLSearchParams(data).toString();
                    window.history.pushState({}, '', url);

                    updateActiveLinks();
                },
                error: function () {
                    $('#loadingSpinner').hide();
                    $('#productGrid').show();
                    alert("Error loading products.");
                }
            });
        }

        function updateActiveLinks() {
            var currentCat = $('#currentCategory').val();
            $('.category-filter').removeClass('fw-bold text-dark').addClass('text-muted');
            if(currentCat) {
                $('.category-filter[data-category="' + currentCat + '"]').removeClass('text-muted').addClass('fw-bold text-dark');
            } else {
                $('.category-filter[data-category=""]').removeClass('text-muted').addClass('fw-bold text-dark');
            }

            var currentBrand = $('#currentBrand').val();
            $('.brand-filter').removeClass('fw-bold text-dark').addClass('text-muted');
            if(currentBrand) {
                $('.brand-filter[data-brand="' + currentBrand + '"]').removeClass('text-muted').addClass('fw-bold text-dark');
            } else {
                $('.brand-filter[data-brand=""]').removeClass('text-muted').addClass('fw-bold text-dark');
            }
        }

        $(document).on('click', '.category-filter', function(e) {
            e.preventDefault();
            $('#currentCategory').val($(this).data('category'));
            loadProducts();
        });

        $(document).on('click', '.brand-filter', function(e) {
            e.preventDefault();
            $('#currentBrand').val($(this).data('brand'));
            loadProducts();
        });

        $(document).on('change', '#sortSelect', function() {
            loadProducts();
        });

        $(document).on('input', '.price-filter', function() {
            clearTimeout(filterTimeout);
            filterTimeout = setTimeout(loadProducts, 500);
        });

        window.clearAllFilters = function() {
            $('#currentQuery').val('');
            $('#currentCategory').val('');
            $('#currentBrand').val('');
            $('#sortSelect').val('');
            $('#minPrice').val('');
            $('#maxPrice').val('');
            loadProducts();
        }
    </script>
}
