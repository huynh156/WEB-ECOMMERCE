@model FashionHubWeb.Models.Brand

@{
    ViewData["Title"] = "Create Brand";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fas fa-tag text-primary mr-2"></i> Add New Brand
                </h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="form-group mb-3">
                        <label asp-for="BrandName" class="font-weight-bold">Brand Name</label>
                        <input asp-for="BrandName" class="form-control" placeholder="e.g. Louis Vuitton, Chanel, Gucci..." required />
                        <span asp-validation-for="BrandName" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Description" class="font-weight-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brand story and heritage..."></textarea>
                    </div>

                    <div class="form-group mb-0">
                        <label asp-for="BrandId" class="font-weight-bold">Brand ID (Optional)</label>
                        <input asp-for="BrandId" class="form-control" placeholder="Leave empty for auto-generated ID" />
                    </div>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left mr-1"></i> Back to Brands
                    </a>
                    <button type="submit" class="btn btn-primary font-weight-bold px-4">
                        <i class="fas fa-check mr-1"></i> Save Brand
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
