@model FashionHubWeb.Models.Brand

@{
    ViewData["Title"] = "Edit Brand: " + Model.BrandName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-outline card-warning shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fas fa-edit text-warning mr-2"></i> Edit Brand
                </h3>
            </div>
            <form asp-action="Edit" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                    <input type="hidden" asp-for="BrandId" />

                    <div class="form-group mb-3">
                        <label class="font-weight-bold text-muted">Brand ID</label>
                        <input class="form-control font-monospace bg-light" value="@Model.BrandId" readonly />
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="BrandName" class="font-weight-bold">Brand Name</label>
                        <input asp-for="BrandName" class="form-control" required />
                        <span asp-validation-for="BrandName" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-0">
                        <label asp-for="Description" class="font-weight-bold">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left mr-1"></i> Back
                    </a>
                    <button type="submit" class="btn btn-warning font-weight-bold text-white px-4">
                        <i class="fas fa-save mr-1"></i> Update Brand
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
