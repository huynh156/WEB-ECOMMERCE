@model IEnumerable<FashionHubWeb.Models.Product>

@{
    ViewData["Title"] = "Product Catalog";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <h3 class="card-title font-weight-bold mb-0">
            <i class="fas fa-boxes text-primary mr-2"></i> Products List (@Model.Count())
        </h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus mr-1"></i> Add New Product
            </a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped align-middle text-nowrap mb-0">
            <thead class="thead-light">
                <tr>
                    <th style="width: 70px;">Image</th>
                    <th>Product Name</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th class="text-right" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-box-open fa-3x mb-2 text-secondary"></i>
                            <p class="mb-0">No products found.</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var firstImg = item.ProductImages?.OrderBy(pi => pi.SortOrder).FirstOrDefault()?.ImagePath;
                        var imgUrl = !string.IsNullOrEmpty(firstImg) ? $"/images/products/{firstImg}" : (item.Image ?? "https://via.placeholder.com/50");

                        <tr>
                            <td>
                                <img src="@imgUrl" alt="@item.ProductName" class="rounded border" style="width: 50px; height: 50px; object-fit: cover;" 
                                     onerror="this.src='https://via.placeholder.com/50?text=No+Img';" />
                            </td>
                            <td>
                                <div class="font-weight-bold text-dark">@item.ProductName</div>
                                <small class="text-muted">ID: @item.ProductId</small>
                            </td>
                            <td>
                                <span class="badge badge-light border px-2 py-1 font-weight-normal">
                                    @(item.Category?.CategoryName ?? "-")
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-light border px-2 py-1 font-weight-normal">
                                    @(item.Brand?.BrandName ?? "-")
                                </span>
                            </td>
                            <td class="font-weight-bold text-success font-size-md">
                                $@item.Price.ToString("0.00")
                            </td>
                            <td>
                                @if (item.StockQuantity > 10)
                                {
                                    <span class="badge badge-success px-2 py-1">@item.StockQuantity in stock</span>
                                }
                                else if (item.StockQuantity > 0)
                                {
                                    <span class="badge badge-warning px-2 py-1">Low: @item.StockQuantity</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger px-2 py-1">Out of Stock</span>
                                }
                            </td>
                            <td class="text-right">
                                <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-info btn-xs" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-warning btn-xs text-white" title="Edit Product">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-danger btn-xs" title="Delete Product">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
