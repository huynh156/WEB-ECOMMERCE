@model FashionHubWeb.Models.Product

@{
    ViewData["Title"] = "Delete Product: " + Model.ProductName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-outline card-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title font-weight-bold mb-0">
                    <i class="fas fa-exclamation-triangle mr-2"></i> Confirm Delete Product
                </h3>
            </div>
            <div class="card-body">
                <p class="text-danger font-weight-bold mb-3">
                    Are you sure you want to permanently delete this product?
                </p>

                <div class="border rounded p-3 bg-light mb-3">
                    <div class="d-flex align-items-center mb-3">
                        <img src="@(Model.Image ?? "https://via.placeholder.com/60")" class="rounded mr-3 border" style="width: 60px; height: 60px; object-fit: cover;" onerror="this.src='https://via.placeholder.com/60?text=No+Img';" />
                        <div>
                            <h5 class="font-weight-bold mb-0 text-dark">@Model.ProductName</h5>
                            <small class="text-muted">SKU: @Model.ProductId</small>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Price:</div>
                        <div class="col-sm-8 font-weight-bold text-success">$@Model.Price.ToString("0.00")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Stock:</div>
                        <div class="col-sm-8">@Model.StockQuantity units</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Category:</div>
                        <div class="col-sm-8">@(Model.Category?.CategoryName ?? "-")</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 font-weight-bold text-muted">Brand:</div>
                        <div class="col-sm-8">@(Model.Brand?.BrandName ?? "-")</div>
                    </div>
                </div>

                <div class="alert alert-warning small mb-0">
                    <i class="fas fa-info-circle mr-1"></i> Deleting this product will remove its image gallery files and remove it from active carts and wishlists.
                </div>
            </div>

            <div class="card-footer bg-white d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Cancel
                </a>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="ProductId" />
                    <button type="submit" class="btn btn-danger font-weight-bold px-4">
                        <i class="fas fa-trash-alt mr-1"></i> Delete Product
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
