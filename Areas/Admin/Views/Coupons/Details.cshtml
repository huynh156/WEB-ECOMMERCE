@model FashionHubWeb.Models.Coupon

@{
    ViewData["Title"] = "Coupon: " + Model.CouponCode;
    var isExpired = Model.ExpiryDate < DateOnly.FromDateTime(DateTime.Today);
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-outline card-info shadow-sm mb-4">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fas fa-ticket-alt text-info mr-2"></i> Coupon Summary
                </h3>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <span class="badge badge-warning text-dark font-weight-bold px-3 py-2 font-monospace font-size-lg mr-3">
                        <i class="fas fa-cut mr-1"></i> @Model.CouponCode
                    </span>
                    @if (Model.IsActive == true && !isExpired && Model.Quantity > 0)
                    {
                        <span class="badge badge-success px-3 py-2">Active</span>
                    }
                    else if (isExpired)
                    {
                        <span class="badge badge-danger px-3 py-2">Expired</span>
                    }
                    else
                    {
                        <span class="badge badge-secondary px-3 py-2">Inactive</span>
                    }
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold text-muted">Discount:</div>
                    <div class="col-sm-8 font-weight-bold text-success font-size-lg">
                        @(Model.DiscountType == "Percentage" ? $"{Model.DiscountAmount}%" : $"${Model.DiscountAmount:0.00}")
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold text-muted">Discount Type:</div>
                    <div class="col-sm-8">@Model.DiscountType</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold text-muted">Minimum Order:</div>
                    <div class="col-sm-8">@(Model.MinOrderValue.HasValue ? $"${Model.MinOrderValue.Value:0.00}" : "None")</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold text-muted">Remaining Quantity:</div>
                    <div class="col-sm-8">@Model.Quantity usages remaining</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold text-muted">Expiry Date:</div>
                    <div class="col-sm-8">@Model.ExpiryDate.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="row">
                    <div class="col-sm-4 font-weight-bold text-muted">Orders Used With:</div>
                    <div class="col-sm-8">
                        <span class="badge badge-info px-2 py-1">@(Model.Orders?.Count ?? 0) orders</span>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Coupons
                </a>
                <a asp-action="Edit" asp-route-id="@Model.CouponId" class="btn btn-warning font-weight-bold text-white px-4">
                    <i class="fas fa-pencil-alt mr-1"></i> Edit Coupon
                </a>
            </div>
        </div>
    </div>
</div>
