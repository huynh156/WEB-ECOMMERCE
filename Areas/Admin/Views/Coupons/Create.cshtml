@model FashionHubWeb.Models.Coupon

@{
    ViewData["Title"] = "Create Coupon";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fas fa-ticket-alt text-primary mr-2"></i> Create Promotional Coupon
                </h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CouponCode" class="font-weight-bold">Coupon Code</label>
                            <input asp-for="CouponCode" class="form-control text-uppercase font-weight-bold" placeholder="e.g. SUMMER50, VIP20" required />
                            <span asp-validation-for="CouponCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="DiscountType" class="font-weight-bold">Discount Type</label>
                            <select asp-for="DiscountType" class="form-control">
                                <option value="Fixed">Fixed Amount ($)</option>
                                <option value="Percentage">Percentage (%)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DiscountAmount" class="font-weight-bold">Discount Value ($ or %)</label>
                            <input asp-for="DiscountAmount" class="form-control" placeholder="0.00" required />
                            <span asp-validation-for="DiscountAmount" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Quantity" class="font-weight-bold">Quantity (Usage Limit)</label>
                            <input asp-for="Quantity" class="form-control" placeholder="100" required />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MinOrderValue" class="font-weight-bold">Minimum Order Amount ($)</label>
                            <input asp-for="MinOrderValue" class="form-control" placeholder="0.00 (Optional)" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ExpiryDate" class="font-weight-bold">Expiry Date</label>
                            <input asp-for="ExpiryDate" type="date" class="form-control" value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" required />
                            <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-group mb-0 mt-2">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" class="custom-control-input" asp-for="IsActive" id="couponActiveSwitch" checked>
                            <label class="custom-control-label font-weight-bold" for="couponActiveSwitch">Active Coupon</label>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left mr-1"></i> Back to Coupons
                    </a>
                    <button type="submit" class="btn btn-primary font-weight-bold px-4">
                        <i class="fas fa-check mr-1"></i> Create Coupon
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
