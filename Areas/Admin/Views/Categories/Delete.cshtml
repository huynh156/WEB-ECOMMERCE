@model FashionHubWeb.Models.Category

@{
    ViewData["Title"] = "Delete Category: " + Model.CategoryName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-outline card-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title font-weight-bold mb-0">
                    <i class="fas fa-exclamation-triangle mr-2"></i> Confirm Delete Category
                </h3>
            </div>
            <div class="card-body">
                <p class="text-danger font-weight-bold mb-3">
                    Are you sure you want to permanently delete this category?
                </p>

                <div class="border rounded p-3 bg-light mb-3">
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Category:</div>
                        <div class="col-sm-8 font-weight-bold text-dark">@Model.CategoryName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Category ID:</div>
                        <div class="col-sm-8 font-monospace text-muted">@Model.CategoryId</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 font-weight-bold text-muted">Linked Products:</div>
                        <div class="col-sm-8 text-danger font-weight-bold">@(Model.Products?.Count ?? 0) products</div>
                    </div>
                </div>

                <div class="alert alert-warning small mb-0">
                    <i class="fas fa-info-circle mr-1"></i> Deleting this category may affect all linked products in your catalog.
                </div>
            </div>

            <div class="card-footer bg-white d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Cancel
                </a>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="CategoryId" />
                    <button type="submit" class="btn btn-danger font-weight-bold px-4">
                        <i class="fas fa-trash-alt mr-1"></i> Delete Category
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
