@model FashionHubWeb.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fas fa-folder-plus text-primary mr-2"></i> Create Category
                </h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="form-group mb-3">
                        <label asp-for="CategoryName" class="font-weight-bold">Category Name</label>
                        <input asp-for="CategoryName" class="form-control" placeholder="e.g. Luxury Handbags, Summer Wear..." required />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-0">
                        <label asp-for="CategoryId" class="font-weight-bold">Category ID (Optional)</label>
                        <input asp-for="CategoryId" class="form-control" placeholder="Leave empty for auto-generated ID" />
                        <small class="text-muted">A unique identifier will be automatically generated if left blank.</small>
                    </div>
                </div>

                <div class="card-footer bg-light d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left mr-1"></i> Back to Categories
                    </a>
                    <button type="submit" class="btn btn-primary font-weight-bold px-4">
                        <i class="fas fa-check mr-1"></i> Save Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
