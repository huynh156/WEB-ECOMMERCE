@model FashionHubWeb.Models.Category

@{
    ViewData["Title"] = "Category: " + Model.CategoryName;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-outline card-info shadow-sm mb-4">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">
                    <i class="fas fa-folder text-info mr-2"></i> Category Overview
                </h3>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold text-muted">Category Name:</div>
                    <div class="col-sm-8 font-weight-bold text-dark font-size-lg">@Model.CategoryName</div>
                </div>
                <div class="row mb-3">
                    <div class="col-sm-4 font-weight-bold text-muted">Category ID:</div>
                    <div class="col-sm-8 font-monospace text-muted">@Model.CategoryId</div>
                </div>
                <div class="row">
                    <div class="col-sm-4 font-weight-bold text-muted">Products in Category:</div>
                    <div class="col-sm-8">
                        <span class="badge badge-info px-2 py-1">@(Model.Products?.Count ?? 0) products</span>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Back to Categories
                </a>
                <a asp-action="Edit" asp-route-id="@Model.CategoryId" class="btn btn-warning font-weight-bold text-white px-4">
                    <i class="fas fa-pencil-alt mr-1"></i> Edit Category
                </a>
            </div>
        </div>

        @if (Model.Products != null && Model.Products.Any())
        {
            <div class="card card-outline card-secondary shadow-sm">
                <div class="card-header">
                    <h3 class="card-title font-weight-bold">
                        <i class="fas fa-boxes text-secondary mr-2"></i> Products in @Model.CategoryName
                    </h3>
                </div>
                <div class="card-body table-responsive p-0">
                    <table class="table table-hover table-striped mb-0 text-nowrap">
                        <thead class="thead-light">
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th class="text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var prod in Model.Products)
                            {
                                <tr>
                                    <td class="font-weight-bold">@prod.ProductName</td>
                                    <td class="text-success font-weight-bold">$@prod.Price.ToString("0.00")</td>
                                    <td>@prod.StockQuantity units</td>
                                    <td class="text-right">
                                        <a asp-controller="Products" asp-action="Details" asp-route-id="@prod.ProductId" class="btn btn-info btn-xs">
                                            <i class="fas fa-eye mr-1"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
