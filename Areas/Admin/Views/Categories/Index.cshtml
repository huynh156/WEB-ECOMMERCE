@model IEnumerable<FashionHubWeb.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <h3 class="card-title font-weight-bold mb-0">
            <i class="fas fa-list text-primary mr-2"></i> Category Management (@Model.Count())
        </h3>
        <div class="card-tools">
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus mr-1"></i> Add Category
            </a>
        </div>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped align-middle text-nowrap mb-0">
            <thead class="thead-light">
                <tr>
                    <th style="width: 80px;">#</th>
                    <th>Category Name</th>
                    <th>Category ID</th>
                    <th>Total Products</th>
                    <th class="text-right" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="fas fa-folder-open fa-3x mb-2 text-secondary"></i>
                            <p class="mb-0">No categories found.</p>
                        </td>
                    </tr>
                }
                else
                {
                    int index = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@(index++)</td>
                            <td class="font-weight-bold text-dark">
                                <i class="fas fa-folder text-warning mr-2"></i> @item.CategoryName
                            </td>
                            <td>
                                <span class="font-monospace text-muted small">@item.CategoryId</span>
                            </td>
                            <td>
                                <span class="badge badge-info px-2 py-1 font-weight-normal">
                                    @(item.Products?.Count ?? 0) products
                                </span>
                            </td>
                            <td class="text-right">
                                <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-info btn-xs" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-warning btn-xs text-white" title="Edit Category">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-danger btn-xs" title="Delete Category">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
