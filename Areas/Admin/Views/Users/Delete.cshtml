@model FashionHubWeb.Models.User

@{
    ViewData["Title"] = "Delete User: " + Model.FullName;
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-outline card-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title font-weight-bold mb-0">
                    <i class="fas fa-exclamation-triangle mr-2"></i> Confirm Delete User
                </h3>
            </div>
            <div class="card-body">
                <p class="text-danger font-weight-bold mb-3">
                    Are you sure you want to permanently delete this user account?
                </p>

                <div class="border rounded p-3 bg-light mb-3">
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Full Name:</div>
                        <div class="col-sm-8 font-weight-bold text-dark">@Model.FullName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Username:</div>
                        <div class="col-sm-8">@@@Model.Username</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Email:</div>
                        <div class="col-sm-8">@Model.Email</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Role:</div>
                        <div class="col-sm-8">
                            <span class="badge @(Model.Role == "Admin" ? "badge-danger" : "badge-info")">@Model.Role</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 font-weight-bold text-muted">Total Orders:</div>
                        <div class="col-sm-8">@(Model.Orders?.Count ?? 0) orders</div>
                    </div>
                </div>

                <div class="alert alert-warning small mb-0">
                    <i class="fas fa-info-circle mr-1"></i> Deleting this account will remove all associated carts and wishlists. Orders may remain in historical records.
                </div>
            </div>

            <div class="card-footer bg-white d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Cancel
                </a>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <button type="submit" class="btn btn-danger font-weight-bold px-4">
                        <i class="fas fa-trash-alt mr-1"></i> Delete Account
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
