@model IEnumerable<FashionHubWeb.Models.User>

@{
    ViewData["Title"] = "User Management";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalUsers = ViewBag.TotalUsers ?? 0;
    string searchTerm = ViewBag.SearchTerm ?? "";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
        <div>
            <h3 class="card-title font-weight-bold mb-0">
                <i class="fas fa-users text-primary mr-2"></i> Recent Active Users (@totalUsers)
            </h3>
            <small class="text-muted d-block">Top 50 users prioritized by recent order activity</small>
        </div>
        <div class="card-tools d-flex align-items-center mt-2 mt-sm-0">
            <form method="get" asp-action="Index" class="form-inline mr-2">
                <div class="input-group input-group-sm" style="width: 250px;">
                    <input type="text" name="search" class="form-control" placeholder="Search name, email, phone..." value="@searchTerm">
                    <div class="input-group-append">
                        <button type="submit" class="btn btn-default">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
            </form>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-user-plus mr-1"></i> Add User
            </a>
        </div>
    </div>

    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped align-middle text-nowrap mb-0">
            <thead class="thead-light">
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>User</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Orders</th>
                    <th>Status</th>
                    <th class="text-right" style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="fas fa-user-slash fa-3x mb-3 text-secondary"></i>
                            <p class="mb-0">No users found.</p>
                        </td>
                    </tr>
                }
                else
                {
                    int index = (currentPage - 1) * 10 + 1;
                    foreach (var item in Model)
                    {
                        var latestOrder = item.Orders?.OrderByDescending(o => o.OrderDate).FirstOrDefault();
                        <tr>
                            <td>@(index++)</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mr-2 font-weight-bold" style="width: 38px; height: 38px; font-size: 14px;">
                                        @(string.IsNullOrEmpty(item.FullName) ? item.Username.Substring(0, 1).ToUpper() : item.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="font-weight-bold text-dark">@item.FullName</div>
                                        <small class="text-muted">@@@item.Username</small>
                                    </div>
                                </div>
                            </td>
                            <td>@item.Email</td>
                            <td>@(item.PhoneNumber == 0 ? "-" : item.PhoneNumber.ToString())</td>
                            <td>
                                @if (item.Role == "Admin")
                                {
                                    <span class="badge badge-danger px-2 py-1"><i class="fas fa-user-shield mr-1"></i> Admin</span>
                                }
                                else
                                {
                                    <span class="badge badge-info px-2 py-1"><i class="fas fa-user mr-1"></i> Customer</span>
                                }
                            </td>
                            <td>
                                <span class="badge badge-secondary font-weight-normal px-2 py-1">
                                    @(item.Orders?.Count ?? 0) orders
                                </span>
                                @if (latestOrder?.OrderDate != null)
                                {
                                    <small class="d-block text-muted" style="font-size: 11px;">
                                        Last: @latestOrder.OrderDate?.ToString("dd/MM/yyyy")
                                    </small>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success px-2 py-1"><i class="fas fa-check-circle mr-1"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary px-2 py-1"><i class="fas fa-ban mr-1"></i> Inactive</span>
                                }
                            </td>
                            <td class="text-right">
                                <a asp-action="Details" asp-route-id="@item.UserId" class="btn btn-info btn-xs" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.UserId" class="btn btn-warning btn-xs text-white" title="Edit User">
                                    <i class="fas fa-pencil-alt"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.UserId" class="btn btn-danger btn-xs" title="Delete User">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer clearfix bg-white border-top">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="text-muted small mb-2 mb-sm-0">
                    Showing page <strong>@currentPage</strong> of <strong>@totalPages</strong> (@totalUsers total users)
                </div>
                <ul class="pagination pagination-sm m-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@searchTerm">&laquo;</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-search="@searchTerm">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@searchTerm">&raquo;</a>
                    </li>
                </ul>
            </div>
        </div>
    }
</div>
