@model FashionHubWeb.ViewModels.AdminDashboardVM
@{
    ViewData["Title"] = "Admin Overview & Analytics Dashboard";
}

<!-- Top Stat Widgets -->
<div class="row">
  <div class="col-lg-3 col-6">
    <div class="small-box bg-info shadow-sm">
      <div class="inner">
        <h3>@Model.TotalProducts</h3>
        <p>Total Products</p>
      </div>
      <div class="icon">
        <i class="fas fa-box"></i>
      </div>
      <a href="/Admin/Products" class="small-box-footer">Manage Products <i class="fas fa-arrow-circle-right"></i></a>
    </div>
  </div>

  <div class="col-lg-3 col-6">
    <div class="small-box bg-success shadow-sm">
      <div class="inner">
        <h3>$@Model.TotalRevenue.ToString("N2")</h3>
        <p>Total Revenue</p>
      </div>
      <div class="icon">
        <i class="fas fa-dollar-sign"></i>
      </div>
      <a href="/Admin/Orders" class="small-box-footer">View Financials <i class="fas fa-arrow-circle-right"></i></a>
    </div>
  </div>

  <div class="col-lg-3 col-6">
    <div class="small-box bg-warning shadow-sm">
      <div class="inner">
        <h3>@Model.TotalOrders</h3>
        <p>Total Orders</p>
      </div>
      <div class="icon">
        <i class="fas fa-shopping-bag"></i>
      </div>
      <a href="/Admin/Orders" class="small-box-footer">Manage Orders <i class="fas fa-arrow-circle-right"></i></a>
    </div>
  </div>

  <div class="col-lg-3 col-6">
    <div class="small-box bg-danger shadow-sm">
      <div class="inner">
        <h3>@Model.TotalUsers</h3>
        <p>Registered Users</p>
      </div>
      <div class="icon">
        <i class="fas fa-users"></i>
      </div>
      <a href="/Admin/Users" class="small-box-footer">User Management <i class="fas fa-arrow-circle-right"></i></a>
    </div>
  </div>
</div>

<!-- Data Visualization Analytics Charts Grid (4 Interactive Charts) -->
<div class="row mt-4">
  <!-- Chart 1: Revenue Trend (Line Chart) -->
  <div class="col-lg-8 mb-4">
    <div class="card card-outline card-success shadow-sm h-100">
      <div class="card-header border-0 d-flex justify-content-between align-items-center">
        <h3 class="card-title font-weight-bold text-dark">
          <i class="fas fa-chart-line text-success mr-2"></i> Monthly Revenue Trend ($)
        </h3>
      </div>
      <div class="card-body">
        <canvas id="revenueTrendChart" style="min-height: 280px; height: 280px; max-height: 280px; width: 100%;"></canvas>
      </div>
    </div>
  </div>

  <!-- Chart 2: Order Status Distribution (Pie Chart) -->
  <div class="col-lg-4 mb-4">
    <div class="card card-outline card-warning shadow-sm h-100">
      <div class="card-header border-0">
        <h3 class="card-title font-weight-bold text-dark">
          <i class="fas fa-chart-pie text-warning mr-2"></i> Order Status Breakdown
        </h3>
      </div>
      <div class="card-body">
        <canvas id="orderStatusChart" style="min-height: 280px; height: 280px; max-height: 280px; width: 100%;"></canvas>
      </div>
    </div>
  </div>

  <!-- Chart 3: Products by Category (Doughnut Chart) -->
  <div class="col-lg-6 mb-4">
    <div class="card card-outline card-info shadow-sm h-100">
      <div class="card-header border-0">
        <h3 class="card-title font-weight-bold text-dark">
          <i class="fas fa-tags text-info mr-2"></i> Products by Category
        </h3>
      </div>
      <div class="card-body">
        <canvas id="categoryChart" style="min-height: 260px; height: 260px; max-height: 260px; width: 100%;"></canvas>
      </div>
    </div>
  </div>

  <!-- Chart 4: Products by Brand (Bar Chart) -->
  <div class="col-lg-6 mb-4">
    <div class="card card-outline card-primary shadow-sm h-100">
      <div class="card-header border-0">
        <h3 class="card-title font-weight-bold text-dark">
          <i class="fas fa-th-large text-primary mr-2"></i> Brand Inventory Breakdown
        </h3>
      </div>
      <div class="card-body">
        <canvas id="brandChart" style="min-height: 260px; height: 260px; max-height: 260px; width: 100%;"></canvas>
      </div>
    </div>
  </div>
</div>

<!-- Recent Orders Table -->
<div class="card card-outline card-primary shadow-sm mt-2">
  <div class="card-header">
    <h3 class="card-title font-weight-bold"><i class="fas fa-clock mr-1 text-primary"></i> Recent Transactions</h3>
  </div>
  <div class="card-body p-0 table-responsive">
    <table class="table table-striped table-hover mb-0">
      <thead class="thead-light">
        <tr>
          <th>Order ID</th>
          <th>Customer</th>
          <th>Date</th>
          <th>Total</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @if (Model.RecentOrders != null && Model.RecentOrders.Any())
        {
          @foreach (var order in Model.RecentOrders)
          {
            <tr>
              <td><code>@order.OrderId</code></td>
              <td>@(order.FullName ?? order.UserId)</td>
              <td>@(order.OrderDate.HasValue ? order.OrderDate.Value.ToString("g") : "N/A")</td>
              <td class="font-weight-bold text-success">$@order.TotalAmount.ToString("N2")</td>
              <td>
                <span class="badge @(order.Status == "Completed" ? "badge-success" : order.Status == "Cancelled" ? "badge-danger" : "badge-info")">
                  @(order.Status ?? "Processing")
                </span>
              </td>
              <td>
                <a href="/Admin/Orders/Details/@order.OrderId" class="btn btn-xs btn-primary"><i class="fas fa-eye"></i> View</a>
              </td>
            </tr>
          }
        }
        else
        {
          <tr>
            <td colspan="6" class="text-center text-muted py-4">No recent orders found.</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      // 1. Revenue Trend Line Chart
      const revLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueLabels));
      const revValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueValues));

      new Chart(document.getElementById('revenueTrendChart'), {
        type: 'line',
        data: {
          labels: revLabels,
          datasets: [{
            label: 'Monthly Revenue ($)',
            data: revValues,
            borderColor: '#28a745',
            backgroundColor: 'rgba(40, 167, 69, 0.15)',
            borderWidth: 3,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#28a745',
            pointRadius: 5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { callback: function(value) { return '$' + value; } }
            }
          }
        }
      });

      // 2. Order Status Breakdown (Pie Chart)
      const statusLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrderStatusLabels));
      const statusCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OrderStatusCounts));

      new Chart(document.getElementById('orderStatusChart'), {
        type: 'pie',
        data: {
          labels: statusLabels,
          datasets: [{
            data: statusCounts,
            backgroundColor: ['#28a745', '#17a2b8', '#ffc107', '#dc3545', '#6c757d']
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } }
        }
      });

      // 3. Category Doughnut Chart
      const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels));
      const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryCounts));

      new Chart(document.getElementById('categoryChart'), {
        type: 'doughnut',
        data: {
          labels: catLabels,
          datasets: [{
            data: catData,
            backgroundColor: ['#17a2b8', '#28a745', '#ffc107', '#dc3545', '#6610f2']
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: 'bottom' } }
        }
      });

      // 4. Brand Inventory Bar Chart
      const brandLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BrandLabels));
      const brandData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BrandCounts));

      new Chart(document.getElementById('brandChart'), {
        type: 'bar',
        data: {
          labels: brandLabels,
          datasets: [{
            label: 'Items in Stock',
            data: brandData,
            backgroundColor: '#007bff',
            borderRadius: 6
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { stepSize: 1 }
            }
          }
        }
      });
    });
  </script>
}
