@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] - FashionHub Admin</title>
  
  <!-- Google Font: Source Sans Pro -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,600,700&display=fallback">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
  <!-- Theme style -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
  <style>
    .font-size-sm { font-size: 0.825rem; }
    .font-size-md { font-size: 1.05rem; }
    .font-size-lg { font-size: 1.25rem; }
    .table td, .table th { vertical-align: middle; }
    .card-outline.card-primary { border-top: 3px solid #007bff; }
    .card-outline.card-warning { border-top: 3px solid #ffc107; }
    .card-outline.card-danger { border-top: 3px solid #dc3545; }
    .card-outline.card-success { border-top: 3px solid #28a745; }
    .card-outline.card-info { border-top: 3px solid #17a2b8; }
    .brand-link { border-bottom: 1px solid #4f5962; }
  </style>
  @await RenderSectionAsync("Styles", required: false)
</head>
<body class="hold-transition sidebar-mini layout-fixed">
<div class="wrapper">

  <!-- Navbar -->
  <nav class="main-header navbar navbar-expand navbar-white navbar-light border-bottom">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
      </li>
      <li class="nav-item d-none d-sm-inline-block">
        <a href="/" class="nav-link font-weight-bold text-primary">
          <i class="fas fa-store mr-1"></i> Main Store Front
        </a>
      </li>
    </ul>
    <ul class="navbar-nav ml-auto">
      <li class="nav-item dropdown">
        <a class="nav-link font-weight-bold" data-toggle="dropdown" href="#">
          <i class="fas fa-user-shield text-danger mr-1"></i> Admin
        </a>
        <div class="dropdown-menu dropdown-menu-right">
          <a href="/Account/Profile" class="dropdown-item">
            <i class="fas fa-user-cog mr-2"></i> My Profile
          </a>
          <div class="dropdown-divider"></div>
          <a href="/Account/Logout" class="dropdown-item text-danger">
            <i class="fas fa-sign-out-alt mr-2"></i> Logout
          </a>
        </div>
      </li>
    </ul>
  </nav>
  <!-- /.navbar -->

  <!-- Main Sidebar Container -->
  <aside class="main-sidebar sidebar-dark-primary elevation-4">
    <!-- Brand Logo -->
    <a href="/Admin" class="brand-link px-3">
      <i class="fas fa-gem text-warning mr-2"></i>
      <span class="brand-text font-weight-bold">FashionHub Admin</span>
    </a>

    <!-- Sidebar -->
    <div class="sidebar">
      <!-- Sidebar Menu -->
      <nav class="mt-3">
        <ul class="nav nav-pills nav-sidebar flex-column nav-child-indent" data-widget="treeview" role="menu" data-accordion="false">
          <li class="nav-item">
            <a href="/Admin" class="nav-link @(currentController == "Home" ? "active" : "")">
              <i class="nav-icon fas fa-tachometer-alt"></i>
              <p>Dashboard</p>
            </a>
          </li>
          
          <li class="nav-header text-uppercase text-muted font-weight-bold" style="font-size: 11px; letter-spacing: 1px;">Store Management</li>
          
          <li class="nav-item">
            <a href="/Admin/Orders" class="nav-link @(currentController == "Orders" ? "active" : "")">
              <i class="nav-icon fas fa-shopping-cart"></i>
              <p>Orders</p>
            </a>
          </li>
          <li class="nav-item">
            <a href="/Admin/Products" class="nav-link @(currentController == "Products" ? "active" : "")">
              <i class="nav-icon fas fa-boxes"></i>
              <p>Products</p>
            </a>
          </li>
          <li class="nav-item">
            <a href="/Admin/Categories" class="nav-link @(currentController == "Categories" ? "active" : "")">
              <i class="nav-icon fas fa-list"></i>
              <p>Categories</p>
            </a>
          </li>
          <li class="nav-item">
            <a href="/Admin/Brands" class="nav-link @(currentController == "Brands" ? "active" : "")">
              <i class="nav-icon fas fa-tags"></i>
              <p>Brands</p>
            </a>
          </li>
          <li class="nav-item">
            <a href="/Admin/Coupons" class="nav-link @(currentController == "Coupons" ? "active" : "")">
              <i class="nav-icon fas fa-ticket-alt"></i>
              <p>Coupons</p>
            </a>
          </li>

          <li class="nav-header text-uppercase text-muted font-weight-bold mt-2" style="font-size: 11px; letter-spacing: 1px;">User Administration</li>
          
          <li class="nav-item">
            <a href="/Admin/Users" class="nav-link @(currentController == "Users" ? "active" : "")">
              <i class="nav-icon fas fa-users"></i>
              <p>Users</p>
            </a>
          </li>
        </ul>
      </nav>
      <!-- /.sidebar-menu -->
    </div>
    <!-- /.sidebar -->
  </aside>

  <!-- Content Wrapper. Contains page content -->
  <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header py-3">
      <div class="container-fluid">
        <div class="row align-items-center">
          <div class="col-sm-6">
            <h1 class="font-weight-bold m-0" style="font-size: 1.5rem;">@ViewData["Title"]</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right bg-transparent p-0 m-0">
              <li class="breadcrumb-item"><a href="/Admin">Admin</a></li>
              @if (currentController != "Home")
              {
                <li class="breadcrumb-item active">@currentController</li>
              }
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- Main content -->
    <section class="content pb-4">
      <div class="container-fluid">
        @RenderBody()
      </div>
    </section>
    <!-- /.content -->
  </div>
  <!-- /.content-wrapper -->

  <footer class="main-footer text-sm py-2">
    <div class="float-right d-none d-sm-inline">
      <b>Version</b> 2.0.0
    </div>
    <strong>Copyright &copy; 2026 <a href="/">FashionHub</a>.</strong> All rights reserved.
  </footer>
</div>
<!-- ./wrapper -->

<!-- jQuery -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<!-- Bootstrap 4 -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.1/js/bootstrap.bundle.min.js"></script>
<!-- AdminLTE App -->
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
