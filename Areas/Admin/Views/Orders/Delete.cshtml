@model FashionHubWeb.Models.Order

@{
    ViewData["Title"] = "Delete Order: #" + Model.OrderId.Substring(0, Math.Min(8, Model.OrderId.Length)).ToUpper();
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-outline card-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h3 class="card-title font-weight-bold mb-0">
                    <i class="fas fa-exclamation-triangle mr-2"></i> Confirm Delete Order
                </h3>
            </div>
            <div class="card-body">
                <p class="text-danger font-weight-bold mb-3">
                    Are you sure you want to permanently delete this order record?
                </p>

                <div class="border rounded p-3 bg-light mb-3">
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Order ID:</div>
                        <div class="col-sm-8 font-monospace font-weight-bold text-dark">#@Model.OrderId.Substring(0, Math.Min(8, Model.OrderId.Length)).ToUpper()</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Order Date:</div>
                        <div class="col-sm-8">@(Model.OrderDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Customer:</div>
                        <div class="col-sm-8 font-weight-bold">@Model.FullName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Total Amount:</div>
                        <div class="col-sm-8 font-weight-bold text-success">$@Model.TotalAmount.ToString("0.00")</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 font-weight-bold text-muted">Status:</div>
                        <div class="col-sm-8">
                            <span class="badge badge-warning">@Model.Status</span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 font-weight-bold text-muted">Items:</div>
                        <div class="col-sm-8">@(Model.OrderDetails?.Sum(od => od.Quantity) ?? 0) items</div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left mr-1"></i> Cancel
                </a>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="OrderId" />
                    <button type="submit" class="btn btn-danger font-weight-bold px-4">
                        <i class="fas fa-trash-alt mr-1"></i> Delete Order
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
